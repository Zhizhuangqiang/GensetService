# Copy to .env for local development. Never commit real credentials.
PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://avnadmin:YOUR_PASSWORD@YOUR_HOST.aivencloud.com:YOUR_PORT/defaultdb

# Optional. Comma-separated browser/Electron origins. Leave blank to allow all origins during development.
CORS_ORIGINS=

# Recommended: paste the Aiven project CA certificate as one line with literal \n characters.
# AIVEN_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Only used when AIVEN_CA_CERT is not supplied. Set true only if the server certificate
# is trusted by the Node runtime. For initial Aiven sslmode=require compatibility, false is typical.
DB_SSL_REJECT_UNAUTHORIZED=false
